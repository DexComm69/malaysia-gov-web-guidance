<?xml version="1.0" encoding="UTF-8"?>
<!-- Child template of Cassiopeia (Joomla 4.1+/5). Rename the folder and <name> to your agency's (e.g. cassiopeia_mdcj).
     Install: copy the folder to templates/, then System > Discover > Install (or: php cli/joomla.php extension:discover
     and extension:discover:install), then make its style the default in System > Site Template Styles. -->
<extension type="template" client="site" method="upgrade">
  <name>cassiopeia_agency</name>
  <version>1.0.0</version>
  <creationDate>2026-11</creationDate>
  <author>Agency web team</author>
  <description>MYDS masthead and SPLaSK tags on Cassiopeia (malaysia-gov-web-guidance starter)</description>
  <inheritable>0</inheritable>
  <parent>cassiopeia</parent>
  <files>
    <filename>index.php</filename>
    <filename>masthead.php</filename>
    <filename>templateDetails.xml</filename>
    <folder>helper</folder>
    <folder>html</folder>
  </files>
  <positions>
    <position>search</position>
    <position>topbar</position>
    <position>menu</position>
    <position>footer</position>
  </positions>
</extension>
